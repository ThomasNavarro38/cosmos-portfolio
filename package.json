{
  "name": "cosmos-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "npm run gate && node scripts/preview-drift.ts && vite build",
    "gate": "node src/derive/index.ts --check && node scripts/tokens.ts --check && node scripts/check-pins.ts",
    "solve": "node src/derive/index.ts",
    "tokens": "node scripts/tokens.ts",
    "preview": "vite preview",
    "compose:preview": "node scripts/preview.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node src/data/validate.ts",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check:pins": "node scripts/check-pins.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "d3-force-3d": "3.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "zod": "4.5.4"
  }
}
